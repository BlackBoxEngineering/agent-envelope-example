# Portal-governed configuration. The vault root lives in the browser portal;
# this process holds no passphrase, no vault file, no local root, and no local
# encryption. Copy this file to .env.local and fill in the values from the portal.

AE_API_KEY=        # portal-issued API key — required for hosted lookup, verify, mint, and MCP governance tools
AE_BOT_ID=         # stable public agent id label, e.g. support-agent; not the bot key/address
AE_DELEGATE_ID=    # active delegate id from Agents; fetches GET /sovereign/delegates/:delegateId
AE_BOT_KEY=        # the bot's own identity signing key (0x hex) — NOT the vault root
AE_MINT_MATERIAL=  # optional: 32-byte mint material (0x hex) from the portal — enables local capability derivation
AE_OWNER_USER_ID=  # vault User id from the portal; owner override for hosted:multi records
AE_LEGITIMACY_ID=  # ae-legit id attached to the active delegate when "Create legitimacy state" is selected

AE_DOMAIN_NAMESPACE=customer-support # namespace used to reconstruct domainSummary when delegate export omits it
AE_DOMAIN_ID=support-ops             # domain id shown in the portal
AE_DOMAIN_KIND=agent                 # domain kind shown in the portal
AE_DOMAIN_ADDRESS=                   # optional override; defaults to delegate issuerAddress
AE_DOMAIN_FINGERPRINT=               # optional override; otherwise derived from address + domainHash

# Hosted prompt escalation demo. Omit these to reuse the shared AE_BOT_*/AE_DELEGATE_*
# values in compact mode. Set all three per role for strict multi-bot hosted audit separation.
AE_READER_BOT_ID=          # optional stable public agent id prefix, e.g. support-reader
AE_READER_DELEGATE_ID=     # reader delegate, normally read-thread on thread:*
AE_READER_BOT_KEY=         # reader bot identity key
AE_READER_MINT_MATERIAL=   # reader mint material
AE_READER_LEGITIMACY_ID=   # optional explicit check against the reader delegate legitimacyRef

AE_REFUND_BOT_ID=          # optional stable public agent id prefix, e.g. support-refund
AE_REFUND_DELEGATE_ID=     # refund delegate, normally issue-refund on order:*
AE_REFUND_BOT_KEY=         # refund bot identity key
AE_REFUND_MINT_MATERIAL=   # refund mint material
AE_REFUND_LEGITIMACY_ID=   # optional explicit check against the refund delegate legitimacyRef

AE_MESSENGER_BOT_ID=       # optional stable public agent id prefix, e.g. support-messenger
AE_MESSENGER_DELEGATE_ID=  # messenger delegate, normally send-message on thread:*
AE_MESSENGER_BOT_KEY=      # messenger bot identity key
AE_MESSENGER_MINT_MATERIAL= # messenger mint material
AE_MESSENGER_LEGITIMACY_ID= # optional explicit check against the messenger delegate legitimacyRef

AE_AUDIT_BOT_ID=           # optional stable public agent id prefix, e.g. support-audit
AE_AUDIT_DELEGATE_ID=      # audit delegate, normally append-audit-note on case:*
AE_AUDIT_BOT_KEY=          # audit bot identity key
AE_AUDIT_MINT_MATERIAL=    # audit mint material
AE_AUDIT_LEGITIMACY_ID=    # optional explicit check against the audit delegate legitimacyRef

AE_REQUIRE_LEGITIMACY=true # hosted prompt demo fails setup when delegates lack required legitimacyRef
AE_REQUIRE_RECORDS=true    # hosted prompt demo fails setup unless records can be registered and verified

# LLM drift demo (llm-drift.js) — optional, runs in mock mode without these
AWS_REGION=        # e.g. us-east-1 — for Bedrock Converse API
BEDROCK_MODEL_ID=  # e.g. us.anthropic.claude-sonnet-4-5-20250929-v1:0 — cross-region inference profile
# AWS credentials come from your environment (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, or IAM role)
