{
  "name": "agent-envelope-example",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Integration examples for AgentEnvelope: sovereign offline authority for action-performing systems, portal-governed mint/verify, and MCP tooling.",
  "scripts": {
    "test": "node --test test.js",
    "sovereign": "node sovereign.js",
    "use:cases": "node use-cases.js",
    "vault:delegate": "node vault-delegate.js",
    "portal:setup": "node portal-setup.js",
    "preflight": "node preflight.js",
    "bot": "node preflight.js && node bot.js",
    "verifier": "node verifier.js",
    "escape:incidents": "node escape-incidents.js",
    "demo": "node preflight.js && node bot.js && node verifier.js",
    "mcp": "node mcp-server.js",
    "llm:drift": "node llm-drift.js",
    "llm:drift:portal": "node llm-drift.js --portal",
    "multi:agent": "node multi-agent.js",
    "hosted:multi": "node preflight.js && node hosted-multi-agent.js",
    "hosted:escalation": "node preflight.js && node hosted-escalation.js",
    "hosted:overreach": "node preflight.js && node hosted-overreach.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1106.0",
    "agent-envelope-mcp": "^1.0.5",
    "agent-envelope-sdk": "^1.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
